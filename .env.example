# ——— Idle RPG: переменные окружения сервера ———
# Скопируйте в .env и заполните. Файл .env в git не попадает.

# HTTP-порт API и раздачи клиента
PORT=3000
# PostgreSQL (в docker-compose задаётся автоматически)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/idle_rpg
# Redis (необязательно: кэш и rate limit; без него — в памяти процесса)
REDIS_URL=

# ——— Telegram ———
# Токен бота от @BotFather
BOT_TOKEN=
# username бота без @ (для реферальных ссылок)
BOT_USERNAME=
# короткое имя Mini App из BotFather (/newapp) — ссылки вида t.me/<bot>/<app>
APP_NAME=
# публичный https-адрес клиента (кнопка «Играть» в боте)
WEBAPP_URL=https://game.example.com
# режим бота: webhook | polling | off
# webhook — нужен WEBHOOK_URL; polling — для локальной отладки; off — бот не запускается
BOT_MODE=webhook
# публичный базовый адрес сервера; вебхук будет зарегистрирован на <WEBHOOK_URL>/api/bot/webhook
WEBHOOK_URL=https://game.example.com
# секрет вебхука (любая случайная строка, Telegram пришлёт её в заголовке)
WEBHOOK_SECRET=
# секрет подписи игровых сессий — обязательно поменяйте
SESSION_SECRET=change-me-to-a-long-random-string
# сколько секунд initData считается свежей
AUTH_MAX_AGE_SEC=86400

# ——— Режим разработчика ———
# включить dev-панель и dev-действия (в проде — false или белый список)
DEV_MODE_ENABLED=false
# Telegram ID разработчиков через запятую
DEV_USER_IDS=
# вход без Telegram (ТОЛЬКО для локальной разработки!)
ALLOW_INSECURE_AUTH=false

# ——— Фичи ———
PAYMENTS_ENABLED=true
NOTIFICATIONS_ENABLED=true
SOCIAL_ENABLED=false
ADS_ENABLED=false
# ID рекламного блока Adsgram (вшивается в клиент при сборке)
VITE_ADSGRAM_BLOCK_ID=

# ——— Баланс и администрирование ———
# путь к JSON-конфигу баланса; файл перечитывается при изменении (горячая перезагрузка)
BALANCE_CONFIG_PATH=
# токен для /api/admin/* (заголовок X-Admin-Token); пусто — админка выключена
ADMIN_TOKEN=
# каталог собранного клиента (по умолчанию apps/client/dist)
STATIC_DIR=

# ——— Аналитика (PostHog, необязательно) ———
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ——— Тонкая настройка ———
# как часто сбрасывать изменённых игроков в БД, мс
FLUSH_INTERVAL_MS=3000
# лимит запросов на игрока в минуту
RATE_LIMIT_PER_MIN=240
